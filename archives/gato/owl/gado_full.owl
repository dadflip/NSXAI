<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:gado="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
>

  <owl:Ontology rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl"/>

  <!-- ================================================================
       NAMED DATATYPES
       (remplacent les blank-node xsd:withRestrictions)
       ================================================================ -->

  <!-- Float dans [0.0 .. 1.0] — utilisé par loopQuality -->
  <rdfs:Datatype rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#FloatUnit">
    <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <owl:withRestrictions rdf:parseType="Collection">
      <rdf:Description>
        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0.0</xsd:minInclusive>
      </rdf:Description>
      <rdf:Description>
        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.0</xsd:maxInclusive>
      </rdf:Description>
    </owl:withRestrictions>
  </rdfs:Datatype>

  <!-- Float dans [0.0 .. 1.0] — utilisé par loopDifficulty -->
  <rdfs:Datatype rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#FloatDifficulty">
    <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    <owl:withRestrictions rdf:parseType="Collection">
      <rdf:Description>
        <xsd:minInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#string">0.0</xsd:minInclusive>
      </rdf:Description>
      <rdf:Description>
        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.0</xsd:maxInclusive>
      </rdf:Description>
    </owl:withRestrictions>
  </rdfs:Datatype>

  <!-- ================================================================
       NAMED UNION CLASSES
       (remplacent les owl:unionOf anonymes)
       ================================================================ -->

  <!-- Emotions ∪ Narrative -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Union_Emotions_Narrative">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Emotions"/>
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Narrative"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Emotions ∪ Relationships -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Union_Emotions_Relationships">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Emotions"/>
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Relationships"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Constraints ∪ Narrative -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Union_Constraints_Narrative">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Constraints"/>
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Narrative"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Narrative ∪ Progression -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Union_Narrative_Progression">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Narrative"/>
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Progression"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Progression ∪ Relationships -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Union_Progression_Relationships">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Progression"/>
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Relationships"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Emotions ∪ Narrative ∪ Progression ∪ Relationships  (SDT_Autonomy isSatisfiedWith) -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Union_Narrative_Progression_GDE">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Narrative"/>
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Progression"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Constraints ∪ Progression  (SDT_Competence isSatisfiedWith) -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Union_Constraints_Progression">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Constraints"/>
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Progression"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Emotions ∪ Relationships  (SDT_Relatedness isSatisfiedWith) -->
  <!-- déjà défini : Union_Emotions_Relationships -->

  <!-- Emotions ∪ Progression  (Yee_Socializing / BrainHex isMotivatedWith) -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Union_Emotions_Progression">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Emotions"/>
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Progression"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Emotions ∪ Relationships  (coversComponent allValuesFrom – Mastermind / Socializer) -->
  <!-- déjà défini : Union_Emotions_Relationships -->

  <!-- Constraints ∪ Narrative  (isMotivatedWith – Seeker/BrainHex) -->
  <!-- déjà défini : Union_Constraints_Narrative -->

  <!-- ================================================================
       NAMED RESTRICTION CLASSES
       (remplacent les owl:Restriction anonymes)
       ================================================================ -->

  <!-- isMotivatedWith some Progression -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Restriction_isMotivatedWith_some_Progression">
    <owl:equivalentClass>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#isMotivatedWith"/>
        <owl:someValuesFrom rdf:resource="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Progression"/>
