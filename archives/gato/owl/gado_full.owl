    </owl:intersectionOf>
  </owl:Class>

  <!-- Player_Type ∩ coversComponent only (Emotions ∪ Relationships)  → Conqueror superclass -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Intersection_PlayerType_coversComponent_Emotions_Relationships">
    <owl:intersectionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Player_Type"/>
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Restriction_coversComponent_only_Emotions_Relationships"/>
    </owl:intersectionOf>
  </owl:Class>

  <!-- Player_Type ∩ coversComponent only (Emotions ∪ Progression ∪ Narrative)  → Seeker superclass -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Intersection_PlayerType_coversComponent_Emotions_Progression_Narrative">
    <owl:intersectionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Player_Type"/>
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Restriction_coversComponent_only_Emotions_Progression_Narrative"/>
    </owl:intersectionOf>
  </owl:Class>

  <!-- Player_Type ∩ coversComponent only (Emotions ∪ Progression ∪ Narrative)  → Survivor superclass -->
  <!-- (réutilisation de la même intersection) -->

  <!-- Self-Determination_Theory ∩ isSatisfiedWith some (Narrative ∪ Progression)  → SDT_Autonomy -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Intersection_SDT_isSatisfiedWith_Narrative_Progression">
    <owl:intersectionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Self-Determination_Theory"/>
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Restriction_isSatisfiedWith_some_Narrative_Progression"/>
    </owl:intersectionOf>
  </owl:Class>

  <!-- Self-Determination_Theory ∩ isSatisfiedWith some (Constraints ∪ Progression)  → SDT_Competence -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Intersection_SDT_isSatisfiedWith_Constraints_Progression">
