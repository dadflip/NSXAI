      </owl:Restriction>
    </owl:equivalentClass>
  </owl:Class>

  <!-- coversComponent allValuesFrom Union_Emotions_Progression ∩ Narrative -->
  <!-- (cas Mastermind: coversComponent only (Emotions ∩ Progression ∩ Narrative)) -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Union_Emotions_Progression_Narrative">
    <owl:unionOf rdf:parseType="Collection">
