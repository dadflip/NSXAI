  </owl:Class>

  <!-- Player_Type ∩ coversComponent only Relationships  → Socializer superclass -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Intersection_PlayerType_coversComponent_Relationships">
