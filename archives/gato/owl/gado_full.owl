  <!-- Motivation theories -->

  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Self-Determination_Theory">
    <rdfs:subClassOf rdf:resource="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Motivation_And_Need_Theory"/>
    <rdfs:comment xml:lang="en">An approach to human motivation and personality that uses traditional empirical methods while employing an organismic metatheory that highlights the importance of humans evolved inner resources for personality development and behavioral self-regulation</rdfs:comment>
  </owl:Class>

