      </owl:Restriction>
    </owl:equivalentClass>
  </owl:Class>

  <!-- describesType allValuesFrom Player_Type -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Restriction_describesType_only_PlayerType">
    <owl:equivalentClass>
      <owl:Restriction>
        <owl:onProperty rdf:resource="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#describesType"/>
        <owl:allValuesFrom rdf:resource="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Player_Type"/>
      </owl:Restriction>
    </owl:equivalentClass>
  </owl:Class>

  <!-- ================================================================
       NAMED INTERSECTION CLASSES
       (remplacent les owl:intersectionOf anonymes pour les subClassOf
        de PlayerType, BrainHex, SDT, Yee…)
       ================================================================ -->

  <!-- Player_Model ∩ describesType only Player_Type  → BrainHex superclass -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Intersection_PlayerModel_describesType_PlayerType">
    <owl:intersectionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Player_Model"/>
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Restriction_describesType_only_PlayerType"/>
    </owl:intersectionOf>
  </owl:Class>

  <!-- Player_Type ∩ coversComponent only Progression  → Achiever superclass -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Intersection_PlayerType_coversComponent_Progression">
    <owl:intersectionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Player_Type"/>
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Restriction_coversComponent_only_Progression"/>
    </owl:intersectionOf>
  </owl:Class>

  <!-- Player_Type ∩ coversComponent only Constraints  → Mastermind superclass -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Intersection_PlayerType_coversComponent_Constraints">
    <owl:intersectionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#Player_Type"/>
      <rdf:Description rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Restriction_coversComponent_only_Constraints"/>
    </owl:intersectionOf>
  </owl:Class>

  <!-- Player_Type ∩ coversComponent only Emotions  → Daredevil superclass -->
  <owl:Class rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_full.owl#Intersection_PlayerType_coversComponent_Emotions">
