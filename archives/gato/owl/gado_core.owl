<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl"
         xmlns="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl#">

  <owl:Ontology rdf:about="https://lms.flipova.fr/nsxai/v1/ontologies/gado_core.owl"/>

  <!-- ================================================================
       OBJECT PROPERTIES
       ================================================================ -->

  <owl:ObjectProperty rdf:about="#composesDynamic">
    <rdfs:domain rdf:resource="#GDE_Mechanic"/>
    <rdfs:range rdf:resource="#GDE_Dynamic"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#isTiedTo">
    <owl:inverseOf rdf:resource="#tiesComponent"/>
    <rdfs:domain rdf:resource="#GDE_Component"/>
    <rdfs:range rdf:resource="#GDE_Mechanic"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#isAppliedTo">
    <rdfs:domain rdf:resource="#Gamification"/>
    <rdfs:range rdf:resource="#Non-Game_Context"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#describesPlayer">
    <owl:inverseOf rdf:resource="#isDescribedByType"/>
    <rdfs:domain rdf:resource="#Player_Type"/>
    <rdfs:range rdf:resource="#Player"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#isClassifiedBy">
    <rdfs:domain rdf:resource="#Player"/>
    <rdfs:range rdf:resource="#Player_Model"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#isDescribedByModel">
    <rdfs:domain rdf:resource="#Player_Type"/>
    <rdfs:range rdf:resource="#Player_Model"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#interactsIn">
    <rdfs:domain rdf:resource="#Player"/>
    <rdfs:range rdf:resource="#Gamification_Context"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#isComprisedOf">
    <rdfs:domain rdf:resource="#Motivation"/>
    <rdfs:range rdf:resource="#Motivational_Component"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#isUsedBy">
    <owl:inverseOf rdf:resource="#makesUseOf"/>
    <rdfs:domain rdf:resource="#Game_Design_Element"/>
    <rdfs:domain rdf:resource="#Motivation_And_Need_Theory"/>
    <rdfs:range rdf:resource="#Gamification"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasPlayerInteraction">
    <owl:inverseOf rdf:resource="#interactsIn"/>
    <rdfs:domain rdf:resource="#Gamification_Context"/>
    <rdfs:range rdf:resource="#Player"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#classifiesPlayer">
    <owl:inverseOf rdf:resource="#isClassifiedBy"/>
    <rdfs:domain rdf:resource="#Player_Model"/>
    <rdfs:range rdf:resource="#Player"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#tiesComponent">
    <rdfs:domain rdf:resource="#GDE_Mechanic"/>
    <rdfs:range rdf:resource="#GDE_Component"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#makesUseOf">
    <rdfs:domain rdf:resource="#Gamification"/>
    <rdfs:range rdf:resource="#Game_Design_Element"/>
    <rdfs:range rdf:resource="#Motivation_And_Need_Theory"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#affordsMotivation">
    <rdfs:domain rdf:resource="#Game_Design_Element"/>
    <rdfs:range rdf:resource="#Motivation"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#isDescribedByType">
    <rdfs:domain rdf:resource="#Player"/>
    <rdfs:range rdf:resource="#Player_Type"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasGamification">
    <owl:inverseOf rdf:resource="#isAppliedTo"/>
    <rdfs:domain rdf:resource="#Non-Game_Context"/>
    <rdfs:range rdf:resource="#Gamification"/>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#describesType">
    <owl:inverseOf rdf:resource="#isDescribedByModel"/>
    <rdfs:domain rdf:resource="#Player_Model"/>
    <rdfs:range rdf:resource="#Player_Type"/>
  </owl:ObjectProperty>

  <!-- ================================================================
       DATATYPE PROPERTIES
       ================================================================ -->

  <owl:DatatypeProperty rdf:about="#archetypeLikes">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#archetypeBrainRegion">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#archetypeBehavior">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="#archetypeChemicalMessenger">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </owl:DatatypeProperty>

  <!-- ================================================================
       NAMED UNION CLASSES
       (chaque owl:unionOf devient une classe nommée réutilisable)
       ================================================================ -->

  <!-- Union: Emotions ∪ Progression -->
  <owl:Class rdf:about="#Union_Emotions_Progression">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="#Emotions"/>
      <rdf:Description rdf:about="#Progression"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Union: Challenges ∪ Win_States -->
  <owl:Class rdf:about="#Union_Challenges_WinStates">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="#Challenges"/>
      <rdf:Description rdf:about="#Win_States"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Union: Challenges ∪ Cooperation ∪ Rewards ∪ Story -->
  <owl:Class rdf:about="#Union_Challenges_Cooperation_Rewards_Story">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="#Challenges"/>
      <rdf:Description rdf:about="#Cooperation"/>
      <rdf:Description rdf:about="#Rewards"/>
      <rdf:Description rdf:about="#Story"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Union: Constraints ∪ Relationships -->
  <owl:Class rdf:about="#Union_Constraints_Relationships">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="#Constraints"/>
      <rdf:Description rdf:about="#Relationships"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Union: Constraints ∪ Emotions -->
  <owl:Class rdf:about="#Union_Constraints_Emotions">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="#Constraints"/>
      <rdf:Description rdf:about="#Emotions"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Union: Challenges ∪ Feedback ∪ Rewards -->
  <owl:Class rdf:about="#Union_Challenges_Feedback_Rewards">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="#Challenges"/>
      <rdf:Description rdf:about="#Feedback"/>
      <rdf:Description rdf:about="#Rewards"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Union: Progression ∪ Relationships -->
  <owl:Class rdf:about="#Union_Progression_Relationships">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="#Progression"/>
      <rdf:Description rdf:about="#Relationships"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Union: Rewards ∪ Win_States -->
  <owl:Class rdf:about="#Union_Rewards_WinStates">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="#Rewards"/>
      <rdf:Description rdf:about="#Win_States"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Union: Competition ∪ Resource_Acquisition ∪ Rewards ∪ Win_States -->
  <owl:Class rdf:about="#Union_Competition_ResourceAcquisition_Rewards_WinStates">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="#Competition"/>
      <rdf:Description rdf:about="#Resource_Acquisition"/>
      <rdf:Description rdf:about="#Rewards"/>
      <rdf:Description rdf:about="#Win_States"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Union: Competition ∪ Status -->
  <owl:Class rdf:about="#Union_Competition_Status">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="#Competition"/>
      <rdf:Description rdf:about="#Status"/>
    </owl:unionOf>
  </owl:Class>

  <!-- Union: Resource_Acquisition ∪ Transactions -->
  <owl:Class rdf:about="#Union_ResourceAcquisition_Transactions">
    <owl:unionOf rdf:parseType="Collection">
      <rdf:Description rdf:about="#Resource_Acquisition"/>
