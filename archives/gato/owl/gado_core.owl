  <!-- ================================================================
       DOMAIN CLASSES
       Les subClassOf référencent maintenant des classes nommées
       ================================================================ -->

  <owl:Class rdf:about="#Gamification_Context">
    <rdfs:comment xml:lang="en">Context of gamification refers to the core service or an activity being gamified</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Game_Context">
    <rdfs:subClassOf rdf:resource="#Gamification_Context"/>
  </owl:Class>

  <owl:Class rdf:about="#Non-Game_Context">
    <rdfs:subClassOf rdf:resource="#Gamification_Context"/>
  </owl:Class>

  <owl:Class rdf:about="#Game_Design_Element">
    <rdfs:comment xml:lang="en">A design pattern that can be incorporated into a game.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#GDE_Dynamic">
    <rdfs:subClassOf rdf:resource="#Game_Design_Element"/>
    <rdfs:comment xml:lang="en">The conceptual structures underlying a game, such as the narrative and rules (constraints) that shape the game.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#GDE_Mechanic">
    <rdfs:subClassOf rdf:resource="#Game_Design_Element"/>
    <rdfs:subClassOf rdf:resource="#Restriction_tiesComponent_someGDEComponent"/>
    <rdfs:comment xml:lang="en">The processes that drive forward the action in a game.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#GDE_Component">
    <rdfs:subClassOf rdf:resource="#Game_Design_Element"/>
    <rdfs:comment xml:lang="en">A particular structure in a game, implementing the game's mechanics and dynamics.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Gamification">
    <rdfs:comment xml:lang="en">Use of game design elements in non-game contexts.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Player"/>
  <owl:Class rdf:about="#Player_Type"/>
  <owl:Class rdf:about="#Player_Model"/>
  <owl:Class rdf:about="#Motivation_And_Need_Theory"/>
  <owl:Class rdf:about="#Motivational_Component"/>

  <owl:Class rdf:about="#Motivation">
    <rdfs:comment xml:lang="en">Motivation is literally the desire to do things.</rdfs:comment>
  </owl:Class>

  <!-- GDE_Dynamic subclasses (pas de blank nodes ici) -->

  <owl:Class rdf:about="#Constraints">
    <rdfs:subClassOf rdf:resource="#GDE_Dynamic"/>
    <rdfs:comment xml:lang="en">Limitations or forced trade-offs</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Emotions">
    <rdfs:subClassOf rdf:resource="#GDE_Dynamic"/>
    <rdfs:comment xml:lang="en">Curiosity, competitiveness, frustration, happiness, and so on</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Narrative">
    <rdfs:subClassOf rdf:resource="#GDE_Dynamic"/>
    <rdfs:comment xml:lang="en">A consistent, ongoing storyline</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Progression">
    <rdfs:subClassOf rdf:resource="#GDE_Dynamic"/>
    <rdfs:comment xml:lang="en">The player's growth and development</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Relationships">
    <rdfs:subClassOf rdf:resource="#GDE_Dynamic"/>
    <rdfs:comment xml:lang="en">Social interactions generating feelings of camaraderie, status, altruism, and so on</rdfs:comment>
  </owl:Class>

  <!-- GDE_Mechanic subclasses — référencent les intersections nommées -->

  <owl:Class rdf:about="#Feedback">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEMechanic_isTiedTo_Progression"/>
    <rdfs:comment xml:lang="en">Information about how the player is doing.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Rewards">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEMechanic_isTiedTo_Emotions_Progression"/>
    <rdfs:comment xml:lang="en">Benefits for some action or achievement</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Challenges">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEMechanic_isTiedTo_Constraints"/>
    <rdfs:comment xml:lang="en">Puzzles or other tasks that require effort to solve</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Cooperation">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEMechanic_isTiedTo_Relationships"/>
    <rdfs:comment xml:lang="en">Players must work together to achieve a shared goal</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Competition">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEMechanic_isTiedTo_Constraints_Relationships"/>
    <rdfs:comment xml:lang="en">One player or group wins, and the other loses</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Story">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEMechanic_isTiedTo_Narrative"/>
  </owl:Class>

  <owl:Class rdf:about="#Transactions">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEMechanic_isTiedTo_Progression_Relationships"/>
    <rdfs:comment xml:lang="en">Trading between players, directly or through intermediaries</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Chances">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEMechanic_isTiedTo_Constraints_Emotions"/>
    <rdfs:comment xml:lang="en">Elements of randomness</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Win_States">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEMechanic_isTiedTo_Constraints"/>
    <rdfs:comment xml:lang="en">The outcomes of a game that constitute "winning".</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Resource_Acquisition">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEMechanic_isTiedTo_Progression"/>
    <rdfs:comment xml:lang="en">Obtaining useful or collectible items</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Status">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEMechanic_isTiedTo_Emotions_Progression_Status"/>
    <rdfs:comment xml:lang="en">The rank or level of a player.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Turns">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEMechanic_isTiedTo_Constraints_Progression"/>
    <rdfs:comment xml:lang="en">Sequential participation by alternating players</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Theme">
    <owl:equivalentClass rdf:resource="#Story"/>
    <rdfs:subClassOf rdf:resource="#Intersection_GDEMechanic_isTiedTo_Narrative"/>
  </owl:Class>

  <!-- GDE_Component subclasses — référencent les intersections nommées -->

  <owl:Class rdf:about="#Achievements">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEComponent_isTiedTo_Challenges_WinStates"/>
    <rdfs:comment xml:lang="en">Defined objectives</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Avatars">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEComponent_isTiedTo_Feedback"/>
    <rdfs:comment xml:lang="en">A virtual representation of a player's character in a game.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Badges">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEComponent_isTiedTo_Challenges_Feedback_Rewards"/>
    <rdfs:comment xml:lang="en">A visual token of an achievement.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Boss_Fights">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEComponent_isTiedTo_Challenges"/>
    <rdfs:comment xml:lang="en">A difficult fight against a high-level opponent.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Collections">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEComponent_isTiedTo_ResourceAcquisition"/>
    <rdfs:comment xml:lang="en">Set of items or badges to accumulate</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Combat">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEComponent_isTiedTo_Competition_Turns"/>
    <rdfs:comment xml:lang="en">A defined battle, typically short-lived</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Content_Unlocking">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEComponent_isTiedTo_Rewards_WinStates"/>
    <rdfs:comment xml:lang="en">Aspects available only when players reach objectives</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Gifting">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEComponent_isTiedTo_Transactions"/>
    <rdfs:comment xml:lang="en">Opportunities to share resources with others</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Leaderboards">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEComponent_isTiedTo_Competition_Feedback"/>
    <rdfs:comment xml:lang="en">A ranked list of participants in a game.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Levels">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEComponent_isTiedTo_Competition_Status"/>
    <rdfs:comment xml:lang="en">Defined steps in player progression</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Points">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEComponent_isTiedTo_Competition_ResourceAcquisition_Rewards_WinStates"/>
    <rdfs:comment xml:lang="en">Numerical representations of game progression</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Quests">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEComponent_isTiedTo_Challenges_Cooperation_Rewards_Story"/>
    <rdfs:comment xml:lang="en">A specific mission or challenge for players of a game.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Social_Graph">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEComponent_isTiedTo_Competition_Cooperation"/>
    <rdfs:comment xml:lang="en">The network of relationships among friends.</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Teams">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEComponent_isTiedTo_Competition_Cooperation"/>
    <rdfs:comment xml:lang="en">Defined groups of players working together for a common goal</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Time_Constraints">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEComponent_isTiedTo_Challenges_Competition_WinStates"/>
  </owl:Class>

  <owl:Class rdf:about="#Virtual_Goods">
    <rdfs:subClassOf rdf:resource="#Intersection_GDEComponent_isTiedTo_ResourceAcquisition_Transactions"/>
    <rdfs:comment xml:lang="en">Virtual items that have value or uniqueness within a game environment.</rdfs:comment>
  </owl:Class>

