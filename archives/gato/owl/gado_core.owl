      <rdf:Description rdf:about="#Progression"/>
    </owl:unionOf>
  </owl:Class>

  <!-- ================================================================
       NAMED RESTRICTION CLASSES
       (chaque owl:Restriction devient une classe nommée)
       ================================================================ -->

  <!-- Restriction: isTiedTo only Progression -->
  <owl:Class rdf:about="#Restriction_isTiedTo_Progression">
    <owl:equivalentClass>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#isTiedTo"/>
        <owl:allValuesFrom rdf:resource="#Progression"/>
      </owl:Restriction>
    </owl:equivalentClass>
  </owl:Class>

  <!-- Restriction: isTiedTo only (Emotions ∪ Progression) -->
  <owl:Class rdf:about="#Restriction_isTiedTo_Emotions_Progression">
